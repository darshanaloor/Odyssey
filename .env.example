# Database Credentials (do not commit actual values)
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# SMTP Settings for Real Email Notifications (active only when SMTP_HOST and SMTP_USERNAME are set)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=your_mail_from_address

# Twilio Settings for Real SMS/WhatsApp Notifications (active only when SID, token, and from number are set)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_number

# LLM API Key (optional)
LLM_API_KEY=your_llm_api_key
